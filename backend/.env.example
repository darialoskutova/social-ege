NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATABASE_SSL=false

# Use either a single DATABASE_URL or the existing split DB_* variables.
# DATABASE_URL=postgresql://social_ege_app:CHANGE_ME@127.0.0.1:5432/social_ege
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=social_ege
DB_USER=social_ege_app
DB_PASSWORD=CHANGE_ME

# Keep authentication disabled until HTTPS and the final public origin exist.
AUTH_ENABLED=false
COOKIE_SECURE=true
SESSION_COOKIE_NAME=social_ege_session
SESSION_TTL_HOURS=168
ACCOUNT_TOKEN_TTL_HOURS=72
# ALLOWED_ORIGINS=https://example.ru
# PUBLIC_ORIGIN=https://example.ru

# Private uploaded work files. Keep this directory outside the public web root.
UPLOAD_STORAGE_DIR=/opt/social-ege/var/uploads
UPLOAD_MAX_BYTES=15728640
